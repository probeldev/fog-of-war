<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-native-location"
        version="1.0.0">

    <name>Native Location</name>
    <description>Native Android location plugin using LocationManager directly</description>
    <license>MIT</license>

    <engines>
        <engine name="cordova" version=">=10.0.0"/>
        <engine name="cordova-android" version=">=9.0.0"/>
    </engines>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="NativeLocation">
                <param name="android-package" value="org.apache.cordova.nativelocation.NativeLocation"/>
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
        </config-file>

        <source-file src="src/android/NativeLocation.java"
                     target-dir="src/org/apache/cordova/nativelocation"/>

        <js-module src="www/nativeLocation.js" name="nativeLocation">
            <clobbers target="navigator.nativeLocation"/>
        </js-module>
    </platform>
</plugin>
